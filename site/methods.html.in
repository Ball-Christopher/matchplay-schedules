<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Schedule methods</title>
<meta name="description" content="How the balanced matchplay schedules were constructed, what failed, the impossibility results, the limits and the open questions.">
<!-- Source: schedules/METHODS.md through site/methods.html.in; written by
     tools/build_pages.py.  Edit METHODS.md, not this file. -->
<meta name="color-scheme" content="light dark">
<script>(function(){try{var t=localStorage.getItem("bowling-theme");if(t==="light"||t==="dark")document.documentElement.setAttribute("data-theme",t);}catch(e){}})();</script>
<style>
  :root { --ink: #16181d; --muted: #6b7280; --rule: #d4d7dd; --link: #1f3b73; --paper: #fff; --card: #f6f7f9; color-scheme: light; }
  @media screen and (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) { --ink: #f4f5f7; --muted: #9aa1ad; --rule: #333842; --link: #9db4e2; --paper: #16181d; --card: #1e222a; color-scheme: dark; }
  }
  @media screen { :root[data-theme="dark"] { --ink: #f4f5f7; --muted: #9aa1ad; --rule: #333842; --link: #9db4e2; --paper: #16181d; --card: #1e222a; color-scheme: dark; } }
  html { background: var(--paper); }
  * { box-sizing: border-box; }
  body {
    position: relative; font: 16px/1.6 "IBM Plex Sans", "Helvetica Neue", Helvetica, Arial, sans-serif;
    color: var(--ink); background: var(--paper); margin: 0 auto; padding: 6vh 16px 4vh; max-width: 48rem;
  }
  a { color: var(--link); }
  h1 { font-size: 1.6rem; margin: 0.6em 0 0.4em; line-height: 1.25; }
  h2 { font-size: 1.15rem; margin: 2.2em 0 0.6em; padding-bottom: 0.3em; border-bottom: 1px solid var(--rule); }
  h3 { font-size: 1rem; margin: 1.6em 0 0.5em; }
  code { font-size: 0.88em; background: var(--card); padding: 0.05em 0.3em; border-radius: 3px; overflow-wrap: anywhere; }
  table { border-collapse: collapse; font-size: 0.88rem; display: block; overflow-x: auto; margin: 1em 0; }
  th, td { padding: 0.4em 0.6em; border-bottom: 1px solid var(--rule); text-align: left; vertical-align: top; }
  th { font-size: 0.8rem; color: var(--muted); }
  li { margin: 0.2em 0; }
  .back { font-size: 0.9rem; }
  .theme-switch {
    position: absolute; top: 12px; right: 16px; font: inherit; font-size: 0.75rem; line-height: 1.5; cursor: pointer;
    padding: 0.1em 0.7em; border: 1px solid var(--rule); border-radius: 999px; background: var(--paper); color: var(--muted);
  }
  @media print { .theme-switch, .back { display: none; } }
</style>
</head>
<body>
<button class="theme-switch" type="button" id="theme" aria-label="Colour theme"></button>
<p class="back"><a href="./">← Schedules</a></p>
<!--BODY-->
<script>
(function () {
  var btn = document.getElementById("theme"), modes = ["auto", "light", "dark"], names = { auto: "◐ Auto", light: "☀ Light", dark: "☾ Dark" }, m = "auto";
  try { m = localStorage.getItem("bowling-theme") || "auto"; } catch (e) {}
  function apply() { btn.textContent = names[m]; if (m === "auto") document.documentElement.removeAttribute("data-theme"); else document.documentElement.setAttribute("data-theme", m); }
  btn.onclick = function () { m = modes[(modes.indexOf(m) + 1) % 3]; try { localStorage.setItem("bowling-theme", m); } catch (e) {} apply(); };
  apply();
})();
</script>
</body>
</html>
