<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Matchplay schedules</title>
<meta name="description" content="Balanced 3-way and 4-way matchplay schedules for leagues of 11 to 40 bowlers: couples, lane pairs and positions all balanced.">
<!-- Source: schedules/site/index.html.in. tools/build_pages.py inlines the
     schedule data and writes docs/index.html; never edit that copy. -->
<meta name="color-scheme" content="light dark">
<script>(function(){try{var t=localStorage.getItem("bowling-theme");if(t==="light"||t==="dark")document.documentElement.setAttribute("data-theme",t);}catch(e){}})();</script>
<style>
  :root {
    --ink: #16181d; --muted: #6b7280; --rule: #d4d7dd;
    --link: #1f3b73; --paper: #fff; --card: #f6f7f9;
    --hi: #fde68a; --hi-ink: #16181d; --pick: #1f3b73; --pick-ink: #fff;
    --off: #9a3412; --block: #eef1f6;
    color-scheme: light;
  }
  @media screen and (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --ink: #f4f5f7; --muted: #9aa1ad; --rule: #333842;
      --link: #9db4e2; --paper: #16181d; --card: #1e222a;
      --hi: #6b5a1e; --hi-ink: #fff8e1; --pick: #9db4e2; --pick-ink: #16181d;
      --off: #fdba74; --block: #232833;
      color-scheme: dark;
    }
  }
  @media screen {
    :root[data-theme="dark"] {
      --ink: #f4f5f7; --muted: #9aa1ad; --rule: #333842;
      --link: #9db4e2; --paper: #16181d; --card: #1e222a;
      --hi: #6b5a1e; --hi-ink: #fff8e1; --pick: #9db4e2; --pick-ink: #16181d;
      --off: #fdba74; --block: #232833;
      color-scheme: dark;
    }
  }
  html { background: var(--paper); }
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  body {
    position: relative;
    font: 16px/1.5 "IBM Plex Sans", "Helvetica Neue", Helvetica, Arial, sans-serif;
    color: var(--ink); background: var(--paper);
    margin: 0 auto; padding: 6vh 16px 4vh; max-width: 72rem;
  }
  @media (min-width: 640px) { body { padding-left: 5vw; padding-right: 5vw; } }
  a { color: var(--link); }
  h1 { font-size: 1.6rem; margin: 0 0 0.2em; }
  p.lede { color: var(--muted); margin: 0; max-width: 46rem; }
  h2 {
    font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--muted); margin: 2.2em 0 0.8em; padding-bottom: 0.4em;
    border-bottom: 1px solid var(--rule);
  }
  .theme-switch {
    position: absolute; top: 12px; right: 16px;
    font: inherit; font-size: 0.75rem; line-height: 1.5; cursor: pointer;
    padding: 0.1em 0.7em; border: 1px solid var(--rule); border-radius: 999px;
    background: var(--paper); color: var(--muted);
  }
  .theme-switch:hover { color: var(--ink); border-color: var(--muted); }
  nav.top { margin-top: 0.8em; font-size: 0.9rem; display: flex; gap: 1.2em; flex-wrap: wrap; }

  .controls { display: grid; gap: 1.2rem 2rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); margin-top: 1.6rem; }
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  legend, .label { font-size: 0.8rem; font-weight: 600; color: var(--muted); margin-bottom: 0.4em; padding: 0; }
  .seg { display: inline-flex; border: 1px solid var(--rule); border-radius: 8px; overflow: hidden; }
  .seg label { cursor: pointer; }
  .seg input { position: absolute; opacity: 0; pointer-events: none; }
  .seg span { display: block; padding: 0.4em 1em; }
  .seg input:checked + span { background: var(--pick); color: var(--pick-ink); }
  .seg input:focus-visible + span { outline: 2px solid var(--link); outline-offset: -2px; }
  select, input[type=number], textarea {
    font: inherit; color: var(--ink); background: var(--card);
    border: 1px solid var(--rule); border-radius: 6px; padding: 0.4em 0.6em;
  }
  input[type=number] { width: 5.5em; }
  .hint { font-size: 0.8rem; color: var(--muted); margin: 0.4em 0 0; }
  .choices { display: grid; gap: 0.5rem; }
  .choice {
    display: grid; grid-template-columns: auto 1fr; gap: 0.1em 0.6em; align-items: baseline;
    border: 1px solid var(--rule); border-radius: 8px; padding: 0.55em 0.8em; cursor: pointer; background: var(--card);
  }
  .choice:has(input:checked) { border-color: var(--pick); box-shadow: inset 0 0 0 1px var(--pick); }
  .choice .t { font-weight: 600; }
  .choice .d { grid-column: 2; font-size: 0.85rem; color: var(--muted); }
  .choice code { font-size: 0.8rem; color: var(--muted); font-weight: 400; margin-left: 0.4em; }
  textarea { width: 100%; min-height: 9rem; resize: vertical; font-size: 0.9rem; }
  .row { display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: center; }
  button.b {
    font: inherit; font-size: 0.85rem; cursor: pointer; padding: 0.35em 0.9em;
    border: 1px solid var(--rule); border-radius: 6px; background: var(--card); color: var(--ink);
  }
  button.b:hover { border-color: var(--muted); }

  .summary { display: grid; gap: 0.6rem; grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr)); }
  .tile { background: var(--card); border-radius: 8px; padding: 0.6em 0.8em; }
  .tile .k { font-size: 0.75rem; color: var(--muted); }
  .tile .v { font-weight: 600; }
  .tile .v.warn::before { content: "▲ "; color: var(--off); }
  ul.notes { margin: 0.9em 0 0; padding-left: 1.2em; }
  ul.notes li { margin: 0.25em 0; }
  details.method { margin-top: 0.8em; font-size: 0.9rem; }
  details.method p { color: var(--muted); }

  .tabs { display: flex; gap: 0.3rem; border-bottom: 1px solid var(--rule); margin: 2rem 0 1rem; }
  .tabs button {
    font: inherit; cursor: pointer; background: none; border: 0; color: var(--muted);
    padding: 0.5em 0.9em; border-bottom: 2px solid transparent; margin-bottom: -1px;
  }
  .tabs button[aria-selected=true] { color: var(--ink); border-bottom-color: var(--pick); font-weight: 600; }
  .scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  table { border-collapse: collapse; font-size: 0.85rem; }
  th, td { padding: 0.35em 0.55em; text-align: left; vertical-align: top; border-bottom: 1px solid var(--rule); }
  thead th { font-size: 0.75rem; color: var(--muted); font-weight: 600; white-space: nowrap; position: sticky; top: 0; background: var(--paper); }
  th.wk { white-space: nowrap; color: var(--muted); font-weight: 600; }
  tr.band th { background: var(--block); color: var(--ink); font-size: 0.8rem; font-weight: 600; padding: 0.4em 0.6em; }
  td.grp { min-width: 7.5rem; }
  .who { display: block; white-space: nowrap; cursor: pointer; border-radius: 4px; padding: 0 0.2em; margin: 0 -0.2em; }
  .who .p { display: inline-block; width: 1.9em; font-size: 0.7rem; color: var(--muted); }
  .who.empty { color: var(--muted); font-style: italic; cursor: default; }
  .who.on { background: var(--hi); color: var(--hi-ink); }
  .wrapsep { display: block; border-top: 1px dashed var(--rule); margin: 0.2em 0; }
  .who.on .p { color: inherit; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  td.num.off { color: var(--off); font-weight: 700; }
  td.num.off::after { content: " ▲"; font-size: 0.7em; }
  tr.on td, tr.on th { background: var(--hi); color: var(--hi-ink); }
  .legend { font-size: 0.8rem; color: var(--muted); margin: 0 0 0.8em; }
  .empty-state { color: var(--muted); }
  #toast { position: fixed; bottom: 1rem; left: 50%; transform: translateX(-50%); background: var(--ink); color: var(--paper); padding: 0.4em 1em; border-radius: 6px; font-size: 0.85rem; }
  footer { margin-top: 3rem; font-size: 0.8rem; color: var(--muted); }

  @media print {
    .theme-switch, nav.top, .controls, .tabs, #exports, #bowlers-view, details.method, footer, #toast { display: none !important; }
    body { padding: 0; max-width: none; }
    #weeks-view { display: block !important; }
    thead th { position: static; }
    table { font-size: 9pt; }
    tr { break-inside: avoid; }
  }
</style>
</head>
<body>
<button class="theme-switch" type="button" id="theme" aria-label="Colour theme"></button>
<h1>Matchplay schedules</h1>
<p class="lede">Balanced schedules for 3-way and 4-way matchplay leagues of 11 to 40 bowlers, plus hybrid seasons that switch between 2-, 3- and 4-way so every couple meets exactly once. In every schedule each couple of bowlers meets equally often, and every bowler gets an even share of the lane pairs and of the bowling positions. Pick a league size, add names if you like, and export the result.</p>
<nav class="top"><a href="methods.html">How they were made, and the limits</a><a href="schedules.json" download>All schedules (JSON)</a></nav>

<div class="controls">
  <fieldset>
    <legend>Bowlers on a lane pair</legend>
    <div class="seg" id="kseg">
      <label><input type="radio" name="k" value="3"><span>3-way</span></label>
      <label><input type="radio" name="k" value="4"><span>4-way</span></label>
      <label><input type="radio" name="k" value="h"><span>Hybrid</span></label>
    </div>
    <p class="hint" id="khint">Each pairing in a group is a match: 3 matches a night in 3-way, 6 in 4-way.</p>
    <div style="margin-top:1rem">
      <label class="label" for="n" style="display:block">Number of bowlers</label>
      <select id="n"></select>
      <p class="hint" id="nhint"></p>
    </div>
    <div style="margin-top:1rem">
      <label class="label" for="lane" style="display:block">First lane</label>
      <input type="number" id="lane" min="1" max="99" value="1">
    </div>
  </fieldset>
  <fieldset>
    <legend>Schedule</legend>
    <div class="choices" id="choices"></div>
  </fieldset>
  <fieldset>
    <legend>Bowler names (optional)</legend>
    <textarea id="names" placeholder="One name per line, in roster order.&#10;Leave blank to use roster numbers." spellcheck="false"></textarea>
    <div class="row" style="margin-top:0.5rem">
      <button class="b" type="button" id="shuffle">Random draw</button>
      <button class="b" type="button" id="unshuffle">List order</button>
    </div>
    <p class="hint" id="namehint">Names stay in this browser; nothing is sent anywhere.</p>
  </fieldset>
</div>

<h2 id="title">Balance</h2>
<div class="summary" id="summary"></div>
<ul class="notes" id="notes"></ul>
<details class="method"><summary>How this schedule was made</summary><p id="method"></p><p><a id="mlink" href="methods.html">Full methods</a></p></details>

<h2>Export</h2>
<div class="row" id="exports">
  <button class="b" type="button" data-x="csv">CSV</button>
  <button class="b" type="button" data-x="toml">Season TOML</button>
  <button class="b" type="button" data-x="json">JSON</button>
  <button class="b" type="button" data-x="copy">Copy TOML</button>
  <button class="b" type="button" data-x="link">Copy link</button>
  <button class="b" type="button" data-x="print">Print</button>
</div>

<div class="tabs" role="tablist">
  <button role="tab" aria-selected="true" data-tab="weeks-view">Weeks</button>
  <button role="tab" aria-selected="false" data-tab="bowlers-view">Bowlers</button>
</div>
<section id="weeks-view">
  <p class="legend" id="poslegend"></p>
  <div class="scroll"><table id="weeks"></table></div>
</section>
<section id="bowlers-view" hidden>
  <p class="legend">How often each bowler is on each lane pair and in each position, and the fewest and most times they meet any one other bowler. ▲ marks a count outside the even share.</p>
  <div class="scroll"><table id="bowlers"></table></div>
</section>
<footer>Click any bowler to pick them out in both views. Schedules are free to use. <a href="methods.html#11-still-open">Open questions</a>.</footer>
<div id="toast" hidden></div>

<script>
const DATA = /*DATA*/null;
const POS = { 2: ["L", "R"], 3: ["L1", "R1", "L2"], 4: ["L1", "R1", "L2", "R2"] };
const POS_TEXT = { 3: "L1 left lane first · R1 right lane first · L2 left lane second", 4: "L1 left lane first · R1 right lane first · L2 left lane second · R2 right lane second",
  h: "Groups of 2, 3 or 4 · L / R left or right lane in 2-way · L1 left lane first · R1 right lane first · L2 left lane second · R2 right lane second · — empty lane pair" };
const KIND_ORDER = { single: 0, vacant: 1, x2: 2, oil: 3, oilx2: 4, uniform: 5, mixed: 6 };
// the groups on lane pair g in week w (hybrid entries store them directly; a wrapped pair holds two 2-way groups)
const groupsAt = (e, w, g) => e.k === "h" ? w[g] : [w.slice(g * e.k, g * e.k + e.k)];
const kOf = v => v === "h" ? "h" : +v;
const $ = s => document.querySelector(s);
const store = { get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } },
                set(k, v) { try { localStorage.setItem(k, v); } catch (e) {} } };

let cur = null, draw = null, picked = null;

// ---- theme switch (same key and behaviour as the results pages) ----------
(function () {
  const btn = $("#theme"), modes = ["auto", "light", "dark"], names = { auto: "◐ Auto", light: "☀ Light", dark: "☾ Dark" };
  let m = store.get("bowling-theme") || "auto";
  const apply = () => { btn.textContent = names[m];
    if (m === "auto") document.documentElement.removeAttribute("data-theme"); else document.documentElement.setAttribute("data-theme", m); };
  btn.onclick = () => { m = modes[(modes.indexOf(m) + 1) % 3]; store.set("bowling-theme", m); apply(); };
  apply();
})();

// ---- choosing a schedule --------------------------------------------------
const byK = k => DATA.filter(e => e.k === k);
function sizes(k) { return [...new Set(byK(k).map(e => e.bowlers))].sort((a, b) => a - b); }
function entriesFor(k, n) {
  return byK(k).filter(e => e.bowlers === n).sort((a, b) => KIND_ORDER[a.kind] - KIND_ORDER[b.kind]);
}
function laneText(e) { const off = Object.keys(e.lane_off).length; return off ? `lane pairs ${off} bowler${off > 1 ? "s" : ""} off` : "lane pairs exact"; }
function blockText(e) { return e.blocks ? `${e.blocks.length} oil patterns (${e.blocks.join("+")})` : ""; }
function describe(e) {
  const bits = [`${e.weeks.length} weeks`, `couples meet ${e.lambda}×`, laneText(e)];
  if (e.k === "h") bits.splice(1, 0, e.mix_text);
  if (e.blocks) bits.push(blockText(e));
  return bits.join(" · ");
}

function fillSizes(k, want) {
  const sel = $("#n"), all = sizes(k);
  sel.innerHTML = all.map(n => `<option value="${n}">${n}</option>`).join("");
  const n = all.includes(want) ? want : all.reduce((a, b) => Math.abs(b - (want || 0)) < Math.abs(a - (want || 0)) ? b : a);
  sel.value = n;
  const missing = []; for (let i = 11; i <= 40; i++) if (!all.includes(i)) missing.push(i);
  $("#nhint").textContent = k === "h"
    ? `Hybrid schedules exist for ${all.join(", ")}. Every couple meets exactly once; the format changes between (or within) weeks.`
    : `${k}-way schedules exist for ${all.join(", ")}. A size one below a multiple of ${k} uses the bigger schedule with an empty slot.`;
  $("#khint").textContent = k === "h"
    ? "Hybrid: each week is 2-way, 3-way or 4-way (or a mix), and every bowler gets the same number of each over the season."
    : "Each pairing in a group is a match: 3 matches a night in 3-way, 6 in 4-way.";
  return n;
}
function fillChoices(k, n, wantId) {
  const list = entriesFor(k, n), box = $("#choices");
  box.innerHTML = list.map(e => `<label class="choice"><input type="radio" name="s" value="${e.id}">
    <span class="t">${e.label}<code>${e.id}</code></span><span class="d">${describe(e)}</span></label>`).join("");
  const pick = list.find(e => e.id === wantId) || list.find(e => !Object.keys(e.lane_off).length) || list[0];
  box.querySelector(`input[value="${pick.id}"]`).checked = true;
  box.onchange = ev => select(ev.target.value);
  return pick.id;
}
function select(id, keepPick) {
  cur = DATA.find(e => e.id === id);
  if (!keepPick) picked = null;
  const k = cur.k;
  document.querySelector(`#kseg input[value="${k}"]`).checked = true;
  history.replaceState(null, "", `#${id}` + (lane() !== 1 ? `&lane=${lane()}` : ""));
  draw = null;
  try { const saved = JSON.parse(store.get("schedules-draw") || "null"); if (saved && saved.id === id) draw = saved.draw; } catch (e) {}
  render();
}
const lane = () => Math.max(1, parseInt($("#lane").value, 10) || 1);

// ---- names ----------------------------------------------------------------
function realSlots() { const s = []; for (let p = 1; p <= cur.slots; p++) if (p !== cur.vacant) s.push(p); return s; }
function nameList() { return $("#names").value.split("\n").map(s => s.trim()).filter(Boolean); }
function slotNames() {
  const names = nameList(), slots = realSlots(), out = {};
  const order = draw && draw.length === slots.length ? draw : slots.map((_, i) => i);
  slots.forEach((p, i) => { const j = order[i]; out[p] = j < names.length ? names[j] : null; });
  return out;
}
function label(p, nm) { return p === cur.vacant ? "empty" : (nm[p] || `Bowler ${p}`); }
function nameHint() {
  const c = nameList().length, b = cur.bowlers;
  let t = "Names stay in this browser; nothing is sent anywhere.";
  if (c > b) t = `${c} names for ${b} places: the last ${c - b} are left out. ` + t;
  else if (c && c < b) t = `${c} names for ${b} places: the rest show as numbers. ` + t;
  if (draw) t = "Random draw in use: names are dealt to roster numbers at random. " + t;
  $("#namehint").textContent = t;
}

// ---- render ---------------------------------------------------------------
function stats() {
  const e = cur, n = e.lanes, h = e.k === "h", lanes = {}, pos = {}, meet = {};
  for (let p = 1; p <= e.slots; p++) { lanes[p] = Array(n).fill(0); pos[p] = Array(h ? 3 : e.k).fill(0); meet[p] = {}; }
  for (const w of e.weeks) for (let g = 0; g < n; g++) for (const grp of groupsAt(e, w, g)) {
    // hybrid: the "position" columns count 2-, 3- and 4-way weeks instead
    grp.forEach((p, q) => { lanes[p][g]++; pos[p][h ? grp.length - 2 : q]++; for (const o of grp) if (o !== p) meet[p][o] = (meet[p][o] || 0) + 1; });
  }
  return { lanes, pos, meet };
}
function render() {
  const e = cur, nm = slotNames(), r = e.weeks.length, k = e.k, n = e.lanes, L = lane();
  nameHint();
  $("#title").textContent = `${e.id}: ${e.label.toLowerCase()}, ${e.bowlers} bowlers, ${r} weeks`;
  const off = Object.keys(e.lane_off).length;
  const tiles = [
    ["Couples", `each meets ${e.lambda}×`, false],
    ["Lane pairs", off ? `${off} bowler${off > 1 ? "s" : ""} off by 1+` : `exact (${e.lane_range[0] === e.lane_range[1] ? e.lane_range[0] : e.lane_range.join("–")} each)`, off > 0],
    e.k === "h" ? ["Formats", `each bowler: ${e.mix_text}`, false]
      : ["Positions", `exact (${e.position_range[0] === e.position_range[1] ? e.position_range[0] : e.position_range.join("–")} each)`, false],
    ["Stopping early", e.worst_prefix <= 1 ? "always within 1" : `worst gap ${e.worst_prefix} meetings`, false],
  ];
  if (e.blocks) tiles.push(["Oil patterns", `${e.blocks.length}: ${e.blocks.join(" + ")} weeks`, false],
                           ["Same-pattern repeats", String(e.block_repeats), e.block_repeats > 0]);
  if (e.vacant) tiles.push(["Empty slot", `roster number ${e.vacant}`, false]);
  if (e.kind === "x2" || e.kind === "oilx2") tiles.push(["Groups repeated in round 2", String(e.repeated_groups || 0), false]);
  if (e.k === "h") tiles.push(["Positions", "even within each format", false]);
  $("#summary").innerHTML = tiles.map(([a, b, w]) => `<div class="tile"><div class="k">${a}</div><div class="v${w ? " warn" : ""}">${b}</div></div>`).join("");
  const notes = [...e.notes];
  if (off) notes.unshift("Off-balance lane pairs: " + Object.entries(e.lane_off).map(([p, c]) => `${esc(label(+p, nm))} (${c.join(", ")})`).join("; ") + `. The even share is ${e.lane_range.join(" or ")}.`);
  if (e.worst_prefix > 1) {
    const w = e.prefix_spread.findIndex(x => x === e.worst_prefix) + 1;
    notes.push(`If the season stops early, the most uneven point is after week ${w}: some couples will have met ${e.worst_prefix} more times than others. By the last week every couple has met ${e.lambda}×.`);
  }
  if (k === 4) notes.push("In a 4-way group every pairing is a match, so a night has 6 matches per group.");
  if (k === "h") notes.push(`See <a href="https://github.com/Ball-Christopher/matchplay-schedules/tree/main/hybrid">the hybrid notes</a> for what's proven and what's still open.`);
  $("#notes").innerHTML = notes.map(t => `<li>${t}</li>`).join("");
  $("#method").textContent = e.method || "See the full methods.";
  $("#mlink").href = `methods.html#${e.methods_anchor}`;
  $("#poslegend").textContent = POS_TEXT[k] + (e.blocks ? " · bands mark the oil patterns" : "");

  // weeks table
  const lanesHead = Array.from({ length: n }, (_, g) => `<th>Lanes ${L + 2 * g}–${L + 2 * g + 1}</th>`).join("");
  let rows = "", cuts = [];
  if (e.blocks) { let s = 0; e.blocks.forEach((b, i) => { cuts.push([s, b, i]); s += b; }); }
  e.weeks.forEach((w, i) => {
    const c = cuts.find(x => x[0] === i);
    if (c) rows += `<tr class="band"><th colspan="${n + 1}">Pattern ${String.fromCharCode(65 + c[2])} · weeks ${i + 1}–${i + c[1]}</th></tr>`;
    if ((e.kind === "x2" || e.kind === "oilx2") && i === r / 2) rows += `<tr class="band"><th colspan="${n + 1}">Round 2 · weeks ${i + 1}–${r}</th></tr>`;
    let cells = "";
    for (let g = 0; g < n; g++) {
      const gs = groupsAt(e, w, g);
      cells += `<td class="grp">` + (gs.length ? gs.map((grp, gi) => (gi ? `<span class="wrapsep" aria-hidden="true"></span>` : "") + grp.map((p, q) => p === e.vacant
        ? `<span class="who empty"><span class="p">${POS[grp.length][q]}</span>empty</span>`
        : `<span class="who${picked === p ? " on" : ""}" data-p="${p}" title="Roster number ${p}"><span class="p">${POS[grp.length][q]}</span>${esc(label(p, nm))}</span>`).join("")).join("")
        : `<span class="who empty">—</span>`) + `</td>`;
    }
    rows += `<tr><th class="wk">Week ${i + 1}</th>${cells}</tr>`;
  });
  $("#weeks").innerHTML = `<thead><tr><th></th>${lanesHead}</tr></thead><tbody>${rows}</tbody>`;

  // bowlers table
  const s = stats(), [lo, hi] = e.lane_range, [plo, phi] = e.position_range || [-Infinity, Infinity];
  const head = `<th>No.</th><th>Bowler</th>` + Array.from({ length: n }, (_, g) => `<th>${L + 2 * g}–${L + 2 * g + 1}</th>`).join("")
             + (k === "h" ? ["2-way", "3-way", "4-way"] : POS[k]).map(x => `<th>${x}</th>`).join("") + `<th>Meets</th>`;
  const body = realSlots().map(p => {
    const ms = realSlots().filter(o => o !== p).map(o => s.meet[p][o] || 0);
    const mn = Math.min(...ms), mx = Math.max(...ms);
    return `<tr data-p="${p}"${picked === p ? ' class="on"' : ""}><td class="num">${p}</td><td><span class="who" data-p="${p}">${esc(label(p, nm))}</span></td>`
      + s.lanes[p].map(c => `<td class="num${c < lo || c > hi ? " off" : ""}">${c}</td>`).join("")
      + s.pos[p].map(c => `<td class="num${c < plo || c > phi ? " off" : ""}">${c}</td>`).join("")
      + `<td class="num">${mn === mx ? mn : mn + "–" + mx}</td></tr>`;
  }).join("");
  $("#bowlers").innerHTML = `<thead><tr>${head}</tr></thead><tbody>${body}</tbody>`;
}
function esc(s) { return String(s).replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c])); }

// ---- exports --------------------------------------------------------------
function csv() {
  const e = cur, nm = slotNames(), k = e.k, L = lane(), q = s => /[",\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
  const rows = [["week", "pattern", "lane_pair", "lanes", "position", "roster_no", "bowler"]];
  if (k === "h") rows[0].splice(2, 0, "format");
  e.weeks.forEach((w, i) => { const pat = patternOf(i);
    for (let g = 0; g < e.lanes; g++) for (const grp of groupsAt(e, w, g)) grp.forEach((p, j) => {
      const row = [i + 1, pat, g + 1, `${L + 2 * g}-${L + 2 * g + 1}`, POS[grp.length][j], p === e.vacant ? "" : p, p === e.vacant ? "(empty)" : label(p, nm)];
      if (k === "h") row.splice(2, 0, `${grp.length}-way`);
      rows.push(row); }); });
  return rows.map(r => r.map(x => q(String(x))).join(",")).join("\n") + "\n";
}
function patternOf(i) { if (!cur.blocks) return ""; let s = 0; for (let b = 0; b < cur.blocks.length; b++) { s += cur.blocks[b]; if (i < s) return String.fromCharCode(65 + b); } return ""; }
function toml() {
  const e = cur, nm = slotNames(), r = e.weeks.length, w2 = String(e.slots).length, tq = s => JSON.stringify(s);
  const out = [`# Matchplay schedule ${e.id}: ${e.label.toLowerCase()}, ${e.bowlers} bowlers, ${r} weeks.`,
    `# ${describe(e)}.`, `# From https://bowling.collapse.nz/schedules/#${e.id}`,
    e.k === "h" ? `# Hybrid: each week lists its lane pairs in order, and each lane pair its groups (2, 3 or 4 bowlers; two 2-way groups = shared lane pair; [] = empty). first_lane = ${lane()}, weeks = ${r}. The league software's fixed 'pattern' setting does not apply.`
      : `# In [league] set: pattern = ${e.k}, first_lane = ${lane()}, weeks = ${r}`];
  if (e.vacant) out.push(`# Roster number ${e.vacant} is the empty slot: its group bowls one short.`);
  out.push("");
  if (nameList().length) {
    for (let p = 1; p <= e.slots; p++) {
      out.push(`# ${p}`, "[[bowlers]]", `name = ${tq(p === e.vacant ? "Vacant" : label(p, nm))}`, "");
    }
  }
  if (e.blocks) { let s = 1; e.blocks.forEach((b, i) => { out.push("[[pattern]]", `name = "Pattern ${String.fromCharCode(65 + i)}"`, `first = ${s}`, `last = ${s + b - 1}`, ""); s += b; }); }
  out.push("[schedule]", "weeks = [");
  e.weeks.forEach((w, i) => out.push(e.k === "h"
    ? `  ${JSON.stringify(w).replace(/,/g, ", ")},  # week ${String(i + 1).padStart(2)}`
    : `  [${w.map(p => String(p).padStart(w2)).join(", ")}],  # week ${String(i + 1).padStart(2)}`));
  out.push("]", "");
  return out.join("\n");
}
function json() {
  const e = cur, nm = slotNames(), bowlers = {};
  for (let p = 1; p <= e.slots; p++) bowlers[p] = p === e.vacant ? null : label(p, nm);
  return JSON.stringify({ id: e.id, group: e.k === "h" ? "hybrid" : e.k, bowlers_count: e.bowlers, first_lane: lane(), blocks: e.blocks, vacant: e.vacant,
    position_order: e.k === "h" ? POS : POS[e.k], formats_per_bowler: e.mix ? { "2-way": e.mix[0], "3-way": e.mix[1], "4-way": e.mix[2] } : undefined,
    bowlers, weeks: e.weeks }, null, 1) + "\n";
}
function save(text, name, type) {
  const a = document.createElement("a");
  a.href = URL.createObjectURL(new Blob([text], { type }));
  a.download = name; document.body.appendChild(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(a.href), 1000);
}
function toast(t) { const el = $("#toast"); el.textContent = t; el.hidden = false; clearTimeout(toast.t); toast.t = setTimeout(() => el.hidden = true, 1800); }
async function copy(t, what) { try { await navigator.clipboard.writeText(t); toast(`${what} copied`); } catch (e) { toast("Copy failed: use the download instead"); } }
$("#exports").onclick = ev => {
  const x = ev.target.dataset.x; if (!x) return;
  if (x === "csv") save(csv(), `schedule-${cur.id}.csv`, "text/csv");
  if (x === "toml") save(toml(), `schedule-${cur.id}.toml`, "application/toml");
  if (x === "json") save(json(), `schedule-${cur.id}.json`, "application/json");
  if (x === "copy") copy(toml(), "TOML");
  if (x === "link") copy(location.href.split("#")[0] + `#${cur.id}` + (lane() !== 1 ? `&lane=${lane()}` : ""), "Link");
  if (x === "print") window.print();
};

// ---- events ---------------------------------------------------------------
document.querySelectorAll(".tabs button").forEach(b => b.onclick = () => {
  document.querySelectorAll(".tabs button").forEach(x => { x.setAttribute("aria-selected", x === b); $("#" + x.dataset.tab).hidden = x !== b; });
});
document.addEventListener("click", ev => {
  const w = ev.target.closest(".who[data-p], tr[data-p]"); if (!w) return;
  const p = +w.dataset.p; picked = picked === p ? null : p; render();
});
$("#kseg").onchange = ev => { const k = kOf(ev.target.value), n = fillSizes(k, +$("#n").value); select(fillChoices(k, n)); };
$("#n").onchange = () => { const k = cur.k, n = +$("#n").value; select(fillChoices(k, n, k === "h" ? null : cur.id.replace(/^\d+w\d+/, `${k}w${n}`))); };
$("#lane").oninput = () => { history.replaceState(null, "", `#${cur.id}` + (lane() !== 1 ? `&lane=${lane()}` : "")); render(); };
$("#names").oninput = () => { store.set("schedules-names", $("#names").value); render(); };
$("#shuffle").onclick = () => {
  const m = realSlots().length, a = [...Array(m).keys()], rnd = new Uint32Array(m); crypto.getRandomValues(rnd);
  for (let i = m - 1; i > 0; i--) { const j = rnd[i] % (i + 1); [a[i], a[j]] = [a[j], a[i]]; }
  draw = a; store.set("schedules-draw", JSON.stringify({ id: cur.id, draw })); render();
};
$("#unshuffle").onclick = () => { draw = null; store.set("schedules-draw", "null"); render(); };

window.addEventListener("hashchange", () => { const id = location.hash.slice(1).split("&")[0]; const e = DATA.find(x => x.id === id); if (e && e !== cur) { fillSizes(e.k, e.bowlers); fillChoices(e.k, e.bowlers, e.id); select(e.id); } });

// ---- start ----------------------------------------------------------------
(function start() {
  $("#names").value = store.get("schedules-names") || "";
  const h = new URLSearchParams(location.hash.slice(1).replace(/^([^&=]+)(&|$)/, "id=$1$2"));
  const ln = parseInt(h.get("lane"), 10); if (ln > 0) $("#lane").value = ln;
  const want = DATA.find(e => e.id === h.get("id")) || DATA.find(e => e.id === "4w20");
  fillSizes(want.k, want.bowlers);
  fillChoices(want.k, want.bowlers, want.id);
  select(want.id);
})();
</script>
</body>
</html>
